# CANDIDATE. Do not rename this file to _headers.
# Cloudflare Pages applies a file named _headers. This name is intentional.
# status:candidate hold:true sealed:false
# No Permissions-Policy is emitted until a human seals the bytes in issue 39.
# https://github.com/atomeam/a-to-mind.com/issues/39
#
# After seal, add only on named HTML paths, in the same commit as the sealed value:
# /sealed-path
#   Permissions-Policy: <exact sealed bytes>
#   X-Robots-Tag: noindex
# Do not set report-to. Do not set Reporting-Endpoints.
