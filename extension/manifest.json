{
  "manifest_version": 3,
  "name": "Void",
  "version": "0.2.0",
  "description": "Void by A-to-Mind in your side panel. Read the tab you point it at and draft into the page; nothing leaves the browser.",
  "key": "",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Open Void"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "commands": {
    "read-tab": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Read this tab into Void"
    }
  },
  "omnibox": {
    "keyword": "void"
  }
}
