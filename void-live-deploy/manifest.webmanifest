{
  "id": "/",
  "name": "Verse",
  "short_name": "Verse",
  "description": "Verse by A-to-Mind: ask for anything and it appears. The weather, a timer, a list, a game, a page about anything.",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#050505",
  "theme_color": "#050505",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "VERSE FILMS", "short_name": "Films", "description": "Watch and review VERSE FILMS", "url": "/films/?source=app", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "What's new", "short_name": "New", "url": "/?q=what%27s%20new&source=app", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  }
}
