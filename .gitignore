_archive*/
node_modules
.wrangler/
*.log
.void-lock
__pycache__/

# Raw intake archives (sha256 + file list are committed next to them)
domains/inputs/**/raw/

# real asks people typed: kept on the machine that pulls them, never in this public repo (tools/pull_misses.py, tools/misses.mjs)
domains/void.misses.md
domains/void.jobs.json
dist/

# Void's own recordings of its experiments (tools/record.mjs): made in CI and kept as run artifacts, never committed
media/
.store-tmp/
site-test-shots/

# the tower gate sweep's slice files (tools/tower-gate.mjs --shard i/N): folded into tower.evidence.json by the merge job, never committed
void-live-deploy/tower.evidence.[0-9]*.json
.paint-src/
void-live-deploy/autopilot/snapshot.json
